# ==============================================================================
# VYOM Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production / staging and replace placeholder values.
# NEVER commit sensitive production secrets to source control.

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend Network & Profiles
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
BACKEND_PORT=8080
# Fallback alias:
PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Connection & Role Segregation (vyom_flyway vs vyom_app)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=payledger

# Runtime application role (restricted DML: SELECT, INSERT, limited UPDATE)
DB_USER=vyom_app
DB_PASSWORD=replace_with_secure_runtime_password
# Standard Spring aliases:
SPRING_DATASOURCE_USERNAME=vyom_app
SPRING_DATASOURCE_PASSWORD=replace_with_secure_runtime_password

# Flyway schema migration role (elevated DDL privileges on schema public)
DB_MIGRATION_USER=vyom_flyway
DB_MIGRATION_PASSWORD=replace_with_secure_flyway_password
# Backward-compatible aliases:
DATABASE_FLYWAY_USERNAME=vyom_flyway
DATABASE_FLYWAY_PASSWORD=replace_with_secure_flyway_password
FLYWAY_USER=vyom_flyway
FLYWAY_PASSWORD=replace_with_secure_flyway_password

# ------------------------------------------------------------------------------
# 3. JWT Security & Secrets (HS256)
# ------------------------------------------------------------------------------
# Production requires a cryptographically strong secret >= 256 bits (32 bytes).
# Generate via: openssl rand -base64 48
JWT_SECRET=replace_with_at_least_256_bit_secure_random_base64_secret
JWT_EXPIRATION_MINUTES=60

# Initial administrative bootstrap (disabled by default; enable only for first setup)
VYOM_ADMIN_BOOTSTRAP_ENABLED=false
VYOM_ADMIN_BOOTSTRAP_EMAIL=admin@vyom.internal
VYOM_ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_admin_bootstrap_password_123!
VYOM_ADMIN_BOOTSTRAP_FULL_NAME=System Administrator

# ------------------------------------------------------------------------------
# 4. Application Server, Logging & Idempotency
# ------------------------------------------------------------------------------
LOG_LEVEL_VYOM=INFO
LOG_LEVEL_ROOT=WARN

# Idempotency lease timeout and janitor daemon
IDEMPOTENCY_TIMEOUT_SECONDS=120
IDEMPOTENCY_JANITOR_ENABLED=true
IDEMPOTENCY_JANITOR_INTERVAL_MS=60000
IDEMPOTENCY_JANITOR_INITIAL_DELAY_MS=10000

# ------------------------------------------------------------------------------
# 5. Express API Gateway Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
GATEWAY_PORT=3000

BACKEND_BASE_URL=http://127.0.0.1:8080
# Backward-compatible alias:
BACKEND_URL=http://127.0.0.1:8080
BACKEND_TIMEOUT_MS=5000

# Reverse Proxy Trust Policy: set to 'false' if directly exposed; 'loopback' behind reverse proxy
TRUST_PROXY=loopback

# Sliding-Window Rate Limiting Thresholds
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_MAX_BUCKETS=10000
