# ==============================================================================
# VYOM Express API Gateway Configuration Template
# ==============================================================================
# Copy this file to gateway/.env if deploying the gateway independently.

NODE_ENV=production
GATEWAY_PORT=3000

BACKEND_BASE_URL=http://127.0.0.1:8080
# Backward-compatible alias:
BACKEND_URL=http://127.0.0.1:8080
BACKEND_TIMEOUT_MS=5000

# Reverse Proxy Trust Policy
# Set to 'false' if directly exposed; set to 'loopback' or trusted proxy IP behind TLS reverse proxy
TRUST_PROXY=loopback

# Sliding-Window Rate Limiting Thresholds
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_MAX_BUCKETS=10000

# JWT Secret for Gateway User-Aware Rate Limiting (must match Spring Boot backend)
JWT_SECRET=replace_with_at_least_256_bit_secure_random_base64_secret

# Logging
LOG_LEVEL=info
